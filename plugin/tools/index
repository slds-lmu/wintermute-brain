#!/usr/bin/env python3
"""Generate every index.md from page frontmatter (01 § 7, 04 R3).

Context: run by tools/commit-op (locally, so the agent's checks see the
indexes), by the index GitHub Action on main after each merge, and by
hand. Agents never edit index files; this script is their only writer.

Output:
  index.md                  root: one line per type folder with a page count
  wiki/<type>/index.md      one OKF line per page:
                            * [Title](/wiki/<type>/<slug>.md) - <description>
  wiki/page/index-a-f.md …  wiki/page/ splits by first letter once it holds
                            more than SPLIT_AT pages; wiki/page/index.md then
                            lists the parts.

Usage: tools/index [--check] [--root DIR]
  --check   exit 1 if any index file would change (used by lint); writes nothing
"""

from __future__ import annotations

import argparse
import string
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from brainlib import TYPES, Page, is_index_file, iter_pages, repo_root  # noqa: E402

# 01 § 5.2: the page/ index splits at ~150 entries.
SPLIT_AT = 150

ROOT_HEADER = "# Index\n\nGenerated by `tools/index`; do not edit. One index per type folder (01 § 7).\n\n"
FOLDER_HEADER = "# {type}\n\nGenerated by `tools/index`; do not edit.\n\n"


def page_line(p: Page) -> str:
    fm = p.frontmatter or {}
    title = str(fm.get("title") or p.slug).replace("]", "\\]")
    description = " ".join(str(fm.get("description") or "").split())
    return f"* [{title}](/{p.rel}) - {description}\n"


def sort_key(p: Page) -> tuple[str, str]:
    fm = p.frontmatter or {}
    return (str(fm.get("title") or p.slug).lower(), p.slug)


def first_letter(p: Page) -> str:
    c = p.slug[:1].lower()
    return c if c in string.ascii_lowercase else "0"


def split_groups(pages: list[Page]) -> list[tuple[str, str, list[Page]]]:
    """Greedy consecutive letter ranges of at most SPLIT_AT pages each.
    Returns [(from_letter, to_letter, pages)]. Digits sort first as '0'."""
    letters = ["0", *string.ascii_lowercase]
    by_letter: dict[str, list[Page]] = {c: [] for c in letters}
    for p in pages:
        by_letter[first_letter(p)].append(p)
    groups: list[tuple[str, str, list[Page]]] = []
    cur: list[Page] = []
    start = None
    last = None
    for c in letters:
        bucket = by_letter[c]
        if cur and len(cur) + len(bucket) > SPLIT_AT and cur:
            groups.append((start, last, cur))
            cur, start = [], None
        if start is None:
            start = c
        cur = cur + bucket
        last = c
    if cur:
        groups.append((start, last, cur))
    return [g for g in groups if g[2]]


def render(root: Path) -> dict[str, str]:
    """Return {repo-relative path: content} for every index file."""
    pages = [p for p in iter_pages(root) if p.type_dir in TYPES]
    by_type: dict[str, list[Page]] = {t: [] for t in TYPES}
    for p in pages:
        by_type[p.type_dir].append(p)
    files: dict[str, str] = {}
    root_lines = []
    for t in TYPES:
        if not (root / "wiki" / t).is_dir():
            continue
        items = sorted(by_type[t], key=sort_key)
        folder_index = f"wiki/{t}/index.md"
        if t == "page" and len(items) > SPLIT_AT:
            parts = split_groups(items)
            folder_body = FOLDER_HEADER.format(type=t)
            for a, b, group in parts:
                name = f"index-{a}-{b}.md"
                files[f"wiki/{t}/{name}"] = (
                    f"# {t} ({a}–{b})\n\nGenerated by `tools/index`; do not edit.\n\n"
                    + "".join(page_line(p) for p in group)
                )
                folder_body += f"* [{a}–{b}](/wiki/{t}/{name}) - {len(group)} pages\n"
                root_lines.append(f"* [{t} {a}–{b}](/wiki/{t}/{name}) - {len(group)} pages\n")
            files[folder_index] = folder_body
        else:
            files[folder_index] = FOLDER_HEADER.format(type=t) + "".join(page_line(p) for p in items)
            root_lines.append(f"* [{t}](/{folder_index}) - {len(items)} pages\n")
    files["index.md"] = ROOT_HEADER + "".join(root_lines)
    return files


def existing_index_files(root: Path) -> set[str]:
    out = set()
    if (root / "index.md").is_file():
        out.add("index.md")
    wiki = root / "wiki"
    if wiki.is_dir():
        for d in wiki.iterdir():
            if d.is_dir():
                out.update(f"wiki/{d.name}/{p.name}" for p in d.glob("*.md") if is_index_file(p))
    return out


def plan(root: Path) -> tuple[dict[str, str], list[str]]:
    """(files to write that differ from disk, stale index files to delete)."""
    wanted = render(root)
    changed = {}
    for rel, content in wanted.items():
        p = root / rel
        if not p.is_file() or p.read_text(encoding="utf-8") != content:
            changed[rel] = content
    stale = sorted(existing_index_files(root) - set(wanted))
    return changed, stale


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--check", action="store_true", help="report, write nothing; exit 1 if out of date")
    ap.add_argument("--root", type=Path, default=None)
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args(argv)
    root = (args.root or repo_root()).resolve()
    if not (root / "wiki").is_dir():
        print(f"no wiki/ under {root}", file=sys.stderr)
        return 2
    changed, stale = plan(root)
    if args.check:
        for rel in sorted(changed):
            print(f"out of date: {rel}")
        for rel in stale:
            print(f"stale: {rel}")
        return 1 if (changed or stale) else 0
    for rel, content in changed.items():
        p = root / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(content, encoding="utf-8")
        if not args.quiet:
            print(f"wrote {rel}")
    for rel in stale:
        (root / rel).unlink()
        if not args.quiet:
            print(f"removed {rel}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
