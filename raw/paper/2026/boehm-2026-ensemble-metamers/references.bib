	langid = {english},
	eprinttype = {arxiv},
	eprint = {1801.03924 [cs]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Graphics},
	file = {Zhang et al. - 2018 - The Unreasonable Effectiveness of Deep Features as.pdf:/home/lukas/Zotero/storage/IZ5DBW35/1801.03924.pdf:application/pdf},
}

@article{zhou_wang_universal_2002,
	title = {A universal image quality index},
	volume = {9},
