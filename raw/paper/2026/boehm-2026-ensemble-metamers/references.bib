@misc{zhou_rethinking_2024,
	title = {Rethinking Centered Kernel Alignment in Knowledge Distillation},
	url = {http://arxiv.org/abs/2401.11824},
	abstract = {Knowledge distillation has emerged as a highly effective method for bridging the representation discrepancy between large-scale models and lightweight models. Prevalent approaches involve leveraging appropriate metrics to minimize the divergence or distance between the knowledge extracted from the teacher model and the knowledge learned by the student model. Centered Kernel Alignment ({CKA}) is widely used to measure representation similarity and has been applied in several knowledge distillation methods. However, these methods are complex and fail to uncover the essence of {CKA}, thus not answering the question of how to use {CKA} to achieve simple and effective distillation properly. This paper first provides a theoretical perspective to illustrate the effectiveness of {CKA}, which decouples {CKA} to the upper bound of Maximum Mean Discrepancy ({MMD}) and a constant term. Drawing from this, we propose a novel Relation-Centered Kernel Alignment ({RCKA}) framework, which practically establishes a connection between {CKA} and {MMD}. Furthermore, we dynamically customize the application of {CKA} based on the characteristics of each task, with less computational source yet comparable performance than the previous methods. The extensive experiments on the {CIFAR}-100, {ImageNet}-1k, and {MS}-{COCO} demonstrate that our method achieves state-of-the-art performance on almost all teacher-student pairs for image classification and object detection, validating the effectiveness of our approaches. Our code is available in https://github.com/Klayand/{PCKA}.},
	number = {{arXiv}:2401.11824},
	publisher = {{arXiv}},
	author = {Zhou, Zikai and Shen, Yunhang and Shao, Shitong and Gong, Linrui and Lin, Shaohui},
	urldate = {2024-05-02},
	date = {2024-04-30},
	langid = {english},
	eprinttype = {arxiv},
	eprint = {2401.11824 [cs]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition},
	file = {Zhou et al. - 2024 - Rethinking Centered Kernel Alignment in Knowledge .pdf:/home/lukas/Zotero/storage/KI8XG77A/Zhou et al. - 2024 - Rethinking Centered Kernel Alignment in Knowledge .pdf:application/pdf},
}

@inproceedings{saha_feature_2022,
	location = {Sydney, Australia},
	title = {Feature Similarity and its Correlation with Accuracy in Knowledge Distillation},
	rights = {https://doi.org/10.15223/policy-029},
	isbn = {978-1-66545-642-5},
	url = {https://ieeexplore.ieee.org/document/10034621/},
	doi = {10.1109/DICTA56598.2022.10034621},
	abstract = {Hint learning is a knowledge distillation technique that transfers intermediate feature maps from a teacher network to a student network, with the goal of improving the student’s performance. Although several studies have proven its benefit, no works have methodically studied nor provided sound intuitions about where to perform hint learning. To that end, in this paper we explore the relationship between feature similarity and its downstream effect on accuracy to gain a better intuition on where to apply hint learning to improve student performance. We conduct a range of hint learning experiments at different locations in the network and then compute the representational similarity variations of the hint pairs using the centered kernel alignment ({CKA}) metric. We find that later-stage hint learning leads to an increase in output feature similarity between teacher and student, in turn increasing accuracy compared to earlierstage hint learning. We rationalise this with evidence from our baseline {CKA} analysis which demonstrates a stronger agreement in higher-level feature representations and a weaker agreement in lower-level features. Therefore, as a consequence of the student and teacher’s capacity gap, matching layers earlier in the network forces the student to a low-level feature representation that is incompatible with its learning. However, despite this mismatch in earlier layers, we find that the student’s performance is not adversely affected because there is sufficient room in the remainder of the network to reconstruct the desired features. However, middle-stage hint learning tends to be more adversely affected by this feature mismatch due to limited room for recovery. Our findings across 4 popular datasets: {CIFAR}-100, Tiny-{ImageNet}, Flowers-102 and Oxford Pets proves the generalisability of our findings and leads us to conclude that late-stage hint learning is generally better than early and middle stages due to a better feature agreement in the late-stage.},
	eventtitle = {2022 International Conference on Digital Image Computing: Techniques and Applications ({DICTA})},
	pages = {1--8},
	booktitle = {2022 International Conference on Digital Image Computing: Techniques and Applications ({DICTA})},
	publisher = {{IEEE}},
	author = {Saha, Aninda and Bialkowski, Alina and Khalifa, Sara},
	urldate = {2024-05-02},
	date = {2022-11-30},
	langid = {english},
	file = {Saha et al. - 2022 - Feature Similarity and its Correlation with Accura.pdf:/home/lukas/Zotero/storage/GCKENMU2/Saha et al. - 2022 - Feature Similarity and its Correlation with Accura.pdf:application/pdf},
}

@misc{paszke_pytorch_2019,
