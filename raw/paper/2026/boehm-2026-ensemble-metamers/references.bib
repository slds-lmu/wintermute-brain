	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Machine Learning, Statistics - Machine Learning, Computer Science - Artificial Intelligence, Quantitative Biology - Neurons and Cognition},
	file = {arXiv Fulltext PDF:/home/lukas/Zotero/storage/XJNP6Q2I/Geirhos et al. - 2020 - Generalisation in humans and deep neural networks.pdf:application/pdf;arXiv.org Snapshot:/home/lukas/Zotero/storage/AAT7U5UT/1808.html:text/html},
